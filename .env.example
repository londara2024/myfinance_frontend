# ---------------------------------------------------------------------------
# Copy to .env.local for local development. Set the same variable in Render's
# dashboard (or let render.yaml declare it) for a deploy.
#
# This file is committed on purpose — it is the only record of which variables
# a deploy needs. It must never hold a real secret.
# ---------------------------------------------------------------------------

# The Spring Boot API. Server-side only — never NEXT_PUBLIC_, because the browser
# must not talk to the backend directly (the bearer token lives in an httpOnly
# cookie the browser cannot read).
#
# REQUIRED in production: the build fails with a message naming this variable
# rather than silently falling back to localhost, where nothing would be
# listening. Locally it defaults to http://localhost:8080.
#
#   local     BACKEND_URL=http://localhost:8080
#   deployed  BACKEND_URL=https://myfinance-backend-aidt.onrender.com
#
# No trailing slash (one is stripped anyway).
BACKEND_URL=http://localhost:8080
